{
  "name": "blechbits",
  "version": "1.0.0",
  "description": "BlechBits BMP to BLECHTRIBE plugin compiler",
  "main": "main.js",
  "author": "Acey",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.zentryx.bitviewconverter",
    "productName": "BlechBits",
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
